{
  "@@locale": "en",

  "appName": "SOOM",
  "@appName": {
    "description": "The product name. Not translated — brand."
  },

  "languageName": "English",
  "@languageName": {
    "description": "This language's own name, shown in the language picker."
  },

  "commonNext": "Next",
  "@commonNext": {
    "description": "Advance to the next step."
  },
  "commonBack": "Back",
  "@commonBack": {
    "description": "Return to the previous step."
  },
  "commonCancel": "Cancel",
  "@commonCancel": {
    "description": "Dismiss without saving."
  },
  "commonSave": "Save",
  "@commonSave": {
    "description": "Persist changes."
  },
  "commonRetry": "Try again",
  "@commonRetry": {
    "description": "Retry a failed action."
  },
  "commonSearch": "Search SOOM",
  "@commonSearch": {
    "description": "Placeholder in the main search field."
  },

  "settingsLanguage": "Language",
  "@settingsLanguage": {
    "description": "Language setting row label."
  },

  "errorGeneric": "Something went wrong. Please try again.",
  "@errorGeneric": {
    "description": "Fallback message for an unexpected failure."
  },
  "errorNoConnection": "No internet connection.",
  "@errorNoConnection": {
    "description": "Shown when the device is offline."
  },

  "forceUpdateTitle": "Update required",
  "@forceUpdateTitle": {
    "description": "Heading when the installed build is no longer supported."
  },
  "forceUpdateBody": "This version of SOOM is no longer supported. Please update to continue.",
  "@forceUpdateBody": {
    "description": "Body of the blocking force-update screen."
  },
  "forceUpdateVersions": "You have {current}; {minimum} is required.",
  "@forceUpdateVersions": {
    "description": "Shows installed versus required version.",
    "placeholders": {
      "current": {
        "type": "String",
        "example": "1.0.0"
      },
      "minimum": {
        "type": "String",
        "example": "1.2.0"
      }
    }
  },

  "loginTitle": "Enter your phone number",
  "@loginTitle": {
    "description": "Heading on the phone login screen (S02)."
  },
  "loginSubtitle": "We'll send you a verification code by SMS.",
  "@loginSubtitle": {
    "description": "Explanation under the login heading."
  },
  "loginPhoneLabel": "Mobile number",
  "@loginPhoneLabel": {
    "description": "Label for the phone field."
  },
  "loginPhoneHint": "5512 3456",
  "@loginPhoneHint": {
    "description": "Placeholder showing the expected 8-digit format. Not translated — it is a number."
  },
  "loginContinue": "Continue",
  "@loginContinue": {
    "description": "Primary action: request the OTP."
  },
  "loginGuestNote": "You can keep browsing without an account. Signing in is only needed to post, chat, or save favourites.",
  "@loginGuestNote": {
    "description": "Reassures the user that browsing does not require login."
  },
  "loginTermsNote": "By continuing you agree to our Terms of Use and Privacy Policy.",
  "@loginTermsNote": {
    "description": "Terms and privacy notice shown above the Continue button."
  },

  "loginErrorTooShort": "Enter all 8 digits of your number.",
  "@loginErrorTooShort": {
    "description": "Validation: fewer than 8 digits entered."
  },
  "loginErrorTooLong": "A Qatar mobile number has 8 digits.",
  "@loginErrorTooLong": {
    "description": "Validation: more than 8 digits entered."
  },
  "loginErrorNotMobile": "Enter a Qatar mobile number starting with 3, 5, 6 or 7.",
  "@loginErrorNotMobile": {
    "description": "Validation: valid length but not a mobile prefix. Landlines start with 4 and cannot receive SMS."
  },
  "loginErrorEmpty": "Enter your mobile number.",
  "@loginErrorEmpty": {
    "description": "Validation: nothing entered."
  },
  "loginErrorRateLimited": "Too many attempts. Please try again shortly.",
  "@loginErrorRateLimited": {
    "description": "Backend rejected the request as rate limited."
  },
  "loginErrorRateLimitedIn": "Too many attempts. Try again in {seconds} seconds.",
  "@loginErrorRateLimitedIn": {
    "description": "Rate limited, with a known wait.",
    "placeholders": {
      "seconds": {
        "type": "int",
        "example": "60"
      }
    }
  },

  "forceUpdateAction": "Update now",
  "@forceUpdateAction": {
    "description": "Button that opens the app store listing."
  },
  "maintenanceTitle": "Under maintenance",
  "@maintenanceTitle": {
    "description": "Heading when the backend reports planned downtime."
  },
  "maintenanceBody": "SOOM is briefly unavailable while we make improvements. Please try again shortly.",
  "@maintenanceBody": {
    "description": "Body of the maintenance screen."
  },

  "directionDemoTitle": "Direction check",
  "@directionDemoTitle": {
    "description": "Title of the RTL/LTR smoke-test screen."
  },
  "directionDemoBody": "This paragraph should start on the leading edge: left in English, right in Arabic. The icon and chevron below must mirror with it.",
  "@directionDemoBody": {
    "description": "Body copy used to verify text direction visually."
  },
  "directionDemoCurrentLocale": "Active locale: {locale}",
  "@directionDemoCurrentLocale": {
    "description": "Shows which locale is active.",
    "placeholders": {
      "locale": {
        "type": "String",
        "example": "ar"
      }
    }
  },
  "directionDemoDirection": "Text direction: {direction}",
  "@directionDemoDirection": {
    "description": "Shows the resolved text direction.",
    "placeholders": {
      "direction": {
        "type": "String",
        "example": "RTL"
      }
    }
  },

  "listingCountLabel": "{count, plural, =0{No listings} =1{1 listing} other{{count} listings}}",
  "@listingCountLabel": {
    "description": "Plural-aware listing count. Arabic needs the full plural set (zero/one/two/few/many/other), which is why this is a plural message rather than string concatenation.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },

  "priceQar": "QAR {amount}",
  "@priceQar": {
    "description": "Price with the Qatari riyal prefix. Qatar is fixed, so the currency is not configurable.",
    "placeholders": {
      "amount": {
        "type": "String",
        "example": "4,500"
      }
    }
  }
}
