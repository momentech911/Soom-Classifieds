# Firebase secrets — do NOT commit to a public repo
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
lib/firebase_options.dart

# Local-only secrets: licence keys, purchase codes, machine-specific config.
# Defence in depth — anything named *.local.* stays out regardless of location.
*.local.md
*.local.json
*.local.yaml
.env
.env.*

# OS
.DS_Store
Thumbs.db

# Vendor reference — purchased eClassify template. Kept local, NEVER committed
# or shipped (this repo is public; the template is licensed, not redistributable).
# vendor/README.md is the one exception: it documents what belongs here.
vendor/*
!vendor/README.md
